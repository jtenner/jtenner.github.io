---
import EditorialLayout from "../layouts/EditorialLayout.astro";
import { getCollection } from "astro:content";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import NavHeader from "../components/NavHeader.astro";
import Footer from "../components/Footer.astro";
import StarField from "../components/StarField.astro";
import AuthorBio from "../components/AuthorBio.astro";
import PostCard from "../components/PostCard.astro";
import {
  BLOG_IDENTITY,
  buildHomepageItemListSchema,
  buildWebsiteSchema,
  type JsonLdPayload,
} from "../lib/structuredData";

const allPosts = (await getCollection("posts")).sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);

const projectLayers = [
  {
    title: "Wago",
    role: "Runtime",
    href: "/projects/wago",
    description: "Compiles WebAssembly to native code and runs it from Go, the CLI, or standalone executables.",
  },
  {
    title: "Dewdrop",
    role: "Language",
    href: "/projects/dewdrop",
    description: "Compiles the Dew programming language directly to WebAssembly GC.",
  },
  {
    title: "Starshine",
    role: "Optimizer",
    href: "/projects/starshine-mb",
    description: "Parses, validates, transforms, fuzzes, and optimizes WebAssembly modules.",
  },
  {
    title: "Facet",
    role: "System interface",
    href: "/projects/facet",
    description: "Defines system calls for Memory32, Memory64, multi-memory, and WebAssembly GC data.",
  },
  {
    title: "stage_left",
    role: "Process model",
    href: "/projects/stage-left",
    description: "Explores actor-style processes, links, signals, and typed messages for Core WebAssembly.",
  },
  {
    title: "as-harness",
    role: "Testing",
    href: "/projects/as-harness",
    description: "Runs AssemblyScript tests through deterministic, replaceable WebAssembly hosts.",
  },
];

const categoryParam = Astro.url.searchParams.get("category") ?? "All";
const categoryFilters = [
  "All",
  ...new Set(allPosts.flatMap((post) => post.data.categories).sort()),
];
const selectedCategory = categoryFilters.includes(categoryParam)
  ? categoryParam
  : "All";

const site = Astro.site ?? Astro.url;
const jsonLd = [
  buildWebsiteSchema({
    site,
    name: BLOG_IDENTITY.siteName,
    description: "Compiler and runtime engineering notes about WebAssembly, programming languages, optimization, fuzzing, and developer tools.",
    publisher: BLOG_IDENTITY.publisher,
  }),
  buildHomepageItemListSchema({
    site,
    visiblePosts: allPosts,
  }),
].filter((schema): schema is JsonLdPayload => Boolean(schema));
---

<EditorialLayout
  title="Assembling Me | Joshua Tenner"
  description="Compiler and runtime engineering notes about WebAssembly, programming languages, optimization, fuzzing, and developer tools."
  jsonLd={jsonLd}
>
  <NavHeader activePage="blog" />

  <main role="main" class="pt-14 sm:pt-16" id="main-content">
    <section class="relative w-full" style="background: radial-gradient(ellipse at 50% 0%, rgba(114,183,229,0.10) 0%, transparent 62%);">
      <StarField height="460px" parallax={true} />
      <div
        class="absolute inset-0 flex flex-col items-center justify-center text-center px-5 sm:px-6"
        style="background: linear-gradient(to bottom, transparent 26%, #151b26 96%);"
      >
        <h1
          class="text-4xl sm:text-6xl lg:text-8xl font-black font-headline tracking-tighter text-on-surface leading-[0.95]"
        >
          Assembling Me
        </h1>
        <p
          class="mt-5 sm:mt-6 max-w-2xl text-base sm:text-lg text-on-surface-variant leading-relaxed"
        >
          I build compilers, WebAssembly runtimes, programming languages, and developer tools.
          I write about optimization, WebAssembly GC, fuzzing, code generation, runtime design, and the problems I find while building them.
        </p>
        <div class="mt-7 sm:mt-8 w-full max-w-sm">
          <AuthorBio compact={true} />
        </div>
      </div>
    </section>

    <section class="max-w-screen-2xl mx-auto px-5 sm:px-6 lg:px-8 pt-14 sm:pt-20" aria-labelledby="building-heading">
      <div class="max-w-4xl">
        <p class="text-[10px] font-bold uppercase tracking-widest text-primary font-headline">
          What I’m building
        </p>
        <h2
          id="building-heading"
          class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-black font-headline tracking-tighter text-on-surface leading-[1.08]"
        >
          One set of tools, from source code to system calls
        </h2>
        <p class="mt-5 text-on-surface-variant text-base sm:text-lg leading-relaxed">
          These are separate projects, but they meet at the same boundary. Dewdrop produces WebAssembly GC. Starshine works on WebAssembly modules. Wago runs them. Facet gives guests access to host services. Stage Left explores isolated processes. as-harness tests code across replaceable WebAssembly hosts.
        </p>
      </div>

      <div class="mt-8 sm:mt-10 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        {projectLayers.map((project) => (
          <a
            href={project.href}
            class="block rounded-lg border border-outline-variant/45 bg-surface-container-low p-5 sm:p-6 hover:border-primary/55 hover:bg-surface-container transition-colors"
          >
            <p class="text-[10px] font-bold uppercase tracking-widest text-primary font-headline">
              {project.role}
            </p>
            <h3 class="mt-2 text-xl font-black font-headline text-on-surface">
              {project.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">
              {project.description}
            </p>
          </a>
        ))}
      </div>

      <p class="mt-7 sm:mt-8 max-w-4xl text-sm leading-relaxed text-outline">
        I use this site as an engineering record. Project pages describe the current design. Older articles remain dated snapshots, with update notes when the project has changed in an important way.
      </p>
    </section>

    <section class="max-w-screen-2xl mx-auto px-5 sm:px-6 lg:px-8 py-14 sm:py-20 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-8 min-w-0">
        <div
          id="post-list"
          class="space-y-6 sm:space-y-8"
          data-post-list
          aria-label="Blog posts"
        >
          {
            allPosts.map((post, index) => (
              <div
                data-post-card
                data-categories={JSON.stringify(post.data.categories ?? [])}
                data-title={post.data.title.toLowerCase()}
                data-description={post.data.description.toLowerCase()}
                data-author={post.data.author.toLowerCase()}
              >
                <PostCard post={post} index={index} />
              </div>
            ))
          }
        </div>

        <p class="mt-10 text-sm text-outline hidden" data-no-posts role="status" aria-live="polite">
          No posts found for the current filters.
        </p>

        <script is:inline>
          requestAnimationFrame(() => {
            const postCards = [...document.querySelectorAll("[data-post-card]")];
            const categoryLinks = [...document.querySelectorAll("[data-category-link]")];
            const noPostsElement = document.querySelector("[data-no-posts]");
            const searchInput = document.querySelector("[data-library-search]");
            const validCategories = new Set(categoryLinks.map((l) => l.dataset.category));

            const render = () => {
              const params = new URLSearchParams(window.location.search);
              const requestedCategory = params.get("category") ?? "All";
              const category = validCategories.has(requestedCategory) ? requestedCategory : "All";
              const query = (params.get("q") ?? "").trim().toLowerCase();

              if (searchInput && searchInput.value !== (params.get("q") ?? "")) {
                searchInput.value = params.get("q") ?? "";
              }

              let visible = 0;
              postCards.forEach((card) => {
                const cats = (() => {
                  try {
                    return JSON.parse(card.dataset.categories || "[]");
                  } catch {
                    return [];
                  }
                })();
                const catMatch = category === "All" || cats.includes(category);
                let textMatch = true;
                if (query) {
                  const title = card.dataset.title ?? "";
                  const desc = card.dataset.description ?? "";
                  const author = card.dataset.author ?? "";
                  textMatch = title.includes(query) || desc.includes(query) || author.includes(query);
                }
                const show = catMatch && textMatch;
                card.style.display = show ? "" : "none";
                if (show) visible++;
              });

              if (noPostsElement) noPostsElement.classList.toggle("hidden", visible > 0);

              categoryLinks.forEach((link) => {
                const isActive = link.dataset.category === category;
                link.classList.toggle("bg-surface-container-high", isActive);
                link.classList.toggle("border-primary", isActive);
                link.classList.toggle("text-primary", isActive);
                link.classList.toggle("text-outline", !isActive);
                link.setAttribute("aria-pressed", isActive ? "true" : "false");
                const qs = new URLSearchParams();
                if (link.dataset.category !== "All") qs.set("category", link.dataset.category);
                if (query) qs.set("q", query);
                link.href = qs.toString() ? `/?${qs}` : "/";
              });
            };

            document.addEventListener("click", (e) => {
              const anchor = e.target.closest("[data-category-link]");
              if (!anchor || !anchor.getAttribute("href")) return;
              e.preventDefault();
              window.history.pushState({}, "", anchor.getAttribute("href"));
              render();
            });

            document.addEventListener("keydown", (e) => {
              const anchor = e.target.closest("[data-category-link]");
              if (!anchor || e.key !== " ") return;
              e.preventDefault();
              anchor.click();
            });

            if (searchInput) {
              searchInput.addEventListener("input", () => {
                const params = new URLSearchParams(window.location.search);
                const category = params.get("category") ?? "All";
                const query = searchInput.value.trim();
                const qs = new URLSearchParams();
                if (category !== "All") qs.set("category", category);
                if (query) qs.set("q", query);
                const url = qs.toString() ? `/?${qs}` : "/";
                if (url !== `${window.location.pathname}${window.location.search}`) {
                  window.history.pushState({}, "", url);
                }
                render();
              });

              searchInput.addEventListener("keydown", (e) => {
                if (e.key !== "Escape") return;
                if (!searchInput.value) return;
                e.preventDefault();
                searchInput.value = "";
                const params = new URLSearchParams(window.location.search);
                const category = params.get("category") ?? "All";
                const qs = new URLSearchParams();
                if (category !== "All") qs.set("category", category);
                const url = qs.toString() ? `/?${qs}` : "/";
                window.history.pushState({}, "", url);
                render();
              });
            }

            window.addEventListener("popstate", render);
            render();
          });
        </script>
      </div>

      <aside class="lg:col-span-4 space-y-10 lg:space-y-16">
        <section aria-labelledby="category-filters-heading">
          <h4
            id="category-filters-heading"
            class="text-[10px] font-bold uppercase tracking-widest text-primary font-headline mb-4"
          >
            Categories
          </h4>
          <div class="flex flex-wrap gap-2 sm:gap-3" aria-label="Filter posts by category">
            {
              categoryFilters.map((category) => (
                <a
                  data-category-link
                  data-category={category}
                  role="button"
                  aria-pressed={category === selectedCategory ? "true" : "false"}
                  aria-controls="post-list"
                  class={`px-3 py-2 text-[10px] font-headline font-black uppercase tracking-[0.18em] border border-outline-variant/45 rounded transition-all ${
                    category === selectedCategory
                      ? "bg-surface-container-high border-primary text-primary"
                      : "text-outline"
                  }`}
                  href={category === "All" ? "/" : `/?category=${category}`}
                >
                  {category}
                </a>
              ))
            }
          </div>
        </section>

        <div
          class="p-5 sm:p-8 bg-surface-container-low border border-outline-variant/40 rounded-lg focus-within:border-primary transition-all"
        >
          <h4
            id="search-label"
            class="text-[10px] font-bold uppercase tracking-widest text-outline font-headline mb-4"
          >
            Search
          </h4>
          <div class="relative flex items-center">
            <input
              aria-labelledby="search-label"
              aria-controls="post-list"
              data-library-search
              class="w-full bg-transparent border-none p-0 focus:ring-0 text-lg sm:text-xl font-headline font-medium placeholder:text-outline text-on-surface"
              placeholder="Search topics..."
              type="search"
              autocomplete="off"
            />
            <span
              aria-hidden="true"
              class="material-symbols-outlined text-outline"
            >
              search
            </span>
          </div>
        </div>

        <FeaturedProjects />
      </aside>
    </section>
  </main>

  <Footer />
</EditorialLayout>
