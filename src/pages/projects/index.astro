---
import EditorialLayout from "../../layouts/EditorialLayout.astro";
import { getCollection } from "astro:content";
import NavHeader from "../../components/NavHeader.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort((a, b) => {
  const aPriority = a.data.featured ?? -1;
  const bPriority = b.data.featured ?? -1;

  if (aPriority !== bPriority) {
    return bPriority - aPriority;
  }

  return a.slug.localeCompare(b.slug);
});
---

<EditorialLayout
  title="Projects | Assembling Me"
  description="Compilers, WebAssembly runtimes, system interfaces, testing tools, and language projects by Joshua Tenner."
>
  <NavHeader activePage="projects" />

  <main role="main" class="pt-32 pb-20 max-w-screen-2xl mx-auto px-8" id="main-content">
    <header class="mb-12 max-w-4xl">
      <p class="text-[10px] font-bold uppercase tracking-widest text-primary font-headline mb-4">
        Projects
      </p>
      <h1 class="text-on-surface text-4xl lg:text-6xl font-black font-headline tracking-tighter leading-tight">
        Tools that meet at the WebAssembly boundary
      </h1>
      <p class="mt-6 text-on-surface-variant text-lg leading-relaxed">
        These projects cover different layers of the same systems work. Wago runs WebAssembly. Dewdrop compiles Dew to WebAssembly GC. Starshine validates and optimizes WebAssembly. Facet defines system calls for modern Core WebAssembly. Other projects explore process models, type systems, and testing infrastructure.
      </p>
    </header>

    <div class="space-y-5">
      {projects.length === 0 && (
        <p class="text-outline">
          No projects yet. Add files in <code class="font-mono">src/content/projects</code>.
        </p>
      )}

      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </main>

  <Footer />
</EditorialLayout>
