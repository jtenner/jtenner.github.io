---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div
  class:list={[
    "bg-surface-container-low border border-outline-variant/10",
    compact ? "rounded px-6 py-5" : "rounded-xl p-10",
  ]}
>
  <div class:list={[compact ? "flex flex-col gap-3" : "flex flex-col gap-6"]}>
    <div>
      <p
        class:list={[
          "font-headline font-black text-on-surface tracking-tighter",
          compact ? "text-lg" : "text-2xl",
        ]}
      >
        Joshua Tenner
      </p>
      <p
        class:list={[
          "text-on-surface-variant font-body",
          compact ? "text-xs mt-1" : "text-sm mt-2",
        ]}
      >
        C# Developer and AI Automation Engineer
      </p>
      {!compact && (
        <p class="text-outline text-xs mt-1 font-headline tracking-wider">
          Dad of three
        </p>
      )}
    </div>
    <div class="flex items-center gap-4">
      <a
        aria-label="Joshua Tenner on LinkedIn (opens in new tab)"
        class="text-slate-500 hover:text-primary transition-colors"
        href="https://www.linkedin.com/in/joshua-tenner-68316167/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span aria-hidden="true" class="material-symbols-outlined text-lg"
          >link</span
        >
      </a>
      <a
        aria-label="Joshua Tenner on GitHub (opens in new tab)"
        class="text-slate-500 hover:text-primary transition-colors"
        href="https://github.com/jtenner/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span aria-hidden="true" class="material-symbols-outlined text-lg"
          >terminal</span
        >
      </a>
    </div>
  </div>
</div>
